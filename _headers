# ==============================================================================
# Moonshine Capital — Cloudflare Pages Edge Security Headers
# ==============================================================================
# Cloudflare Pages manages static-asset caching and invalidates assets on deploy.
# Do not mark unversioned styles.css or script.js immutable; doing so can serve
# stale frontend assets after a production deployment.

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(self), autoplay=(self), camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; script-src 'self' 'unsafe-inline' https://tally.so https://*.tally.so https://calendar.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://calendar.google.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: https://tally.so https://*.tally.so https://i.ytimg.com https://img.youtube.com; frame-src 'self' https://tally.so https://*.tally.so https://www.youtube.com https://www.youtube-nocookie.com https://calendar.google.com; connect-src 'self' https://tally.so https://*.tally.so https://calendar.google.com; form-action 'self' https://tally.so https://*.tally.so; upgrade-insecure-requests

# HTML should always revalidate so production deploys surface immediately.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/*/*.html
  Cache-Control: public, max-age=0, must-revalidate

/*/*/*.html
  Cache-Control: public, max-age=0, must-revalidate
